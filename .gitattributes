* text=auto

# Ensure shell scripts keep LF (important for Linux containers)
*.sh text eol=lf
gradlew text eol=lf

# Normalize source files
*.java text eol=lf
*.kt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Keep Windows endings for batch files
*.bat text eol=crlf
gradlew.bat text eol=crlf


